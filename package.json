{
    "name": "@lbd-hackers/twb",
    "version": "0.5.2",
    "description": "TWB (thin-walled blueprints): the ontology, the house file and its JSON-LD context, IFC to TWB, the @surfacekit drawing engine, a validator with SHACL on Oxigraph and the <arch-paper-model> viewer",
    "keywords": [
        "twb",
        "thin-walled blueprints",
        "bim",
        "ifc",
        "linked building data",
        "lbd",
        "bot",
        "ontology",
        "json-ld",
        "rdf",
        "timber frame"
    ],
    "homepage": "https://twb.madsholten.dk",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/LBD-Hackers/twb.git"
    },
    "bugs": "https://github.com/LBD-Hackers/twb/issues",
    "author": "Mads Holten Rasmussen",
    "license": "Apache-2.0 AND CC-BY-4.0",
    "type": "module",
    "main": "./dist/index.cjs",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        },
        "./house": {
            "import": {
                "types": "./dist/house/index.d.ts",
                "default": "./dist/house/index.js"
            },
            "require": {
                "types": "./dist/house/index.d.cts",
                "default": "./dist/house/index.cjs"
            }
        },
        "./ifc": {
            "import": {
                "types": "./dist/ifc/index.d.ts",
                "default": "./dist/ifc/index.js"
            },
            "require": {
                "types": "./dist/ifc/index.d.cts",
                "default": "./dist/ifc/index.cjs"
            }
        },
        "./elements": {
            "import": {
                "types": "./dist/elements/index.d.ts",
                "default": "./dist/elements/index.js"
            },
            "require": {
                "types": "./dist/elements/index.d.cts",
                "default": "./dist/elements/index.cjs"
            }
        },
        "./surfacekit/core": {
            "import": {
                "types": "./dist/surfacekit/core/index.d.ts",
                "default": "./dist/surfacekit/core/index.js"
            },
            "require": {
                "types": "./dist/surfacekit/core/index.d.cts",
                "default": "./dist/surfacekit/core/index.cjs"
            }
        },
        "./surfacekit/grid": {
            "import": {
                "types": "./dist/surfacekit/grid/index.d.ts",
                "default": "./dist/surfacekit/grid/index.js"
            },
            "require": {
                "types": "./dist/surfacekit/grid/index.d.cts",
                "default": "./dist/surfacekit/grid/index.cjs"
            }
        },
        "./surfacekit/model": {
            "import": {
                "types": "./dist/surfacekit/model/index.d.ts",
                "default": "./dist/surfacekit/model/index.js"
            },
            "require": {
                "types": "./dist/surfacekit/model/index.d.cts",
                "default": "./dist/surfacekit/model/index.cjs"
            }
        },
        "./surfacekit/interaction": {
            "import": {
                "types": "./dist/surfacekit/interaction/index.d.ts",
                "default": "./dist/surfacekit/interaction/index.js"
            },
            "require": {
                "types": "./dist/surfacekit/interaction/index.d.cts",
                "default": "./dist/surfacekit/interaction/index.cjs"
            }
        },
        "./surfacekit/render": {
            "import": {
                "types": "./dist/surfacekit/render/index.d.ts",
                "default": "./dist/surfacekit/render/index.js"
            },
            "require": {
                "types": "./dist/surfacekit/render/index.d.cts",
                "default": "./dist/surfacekit/render/index.cjs"
            }
        },
        "./validate": {
            "import": {
                "types": "./dist/validate/index.d.ts",
                "default": "./dist/validate/index.js"
            },
            "require": {
                "types": "./dist/validate/index.d.cts",
                "default": "./dist/validate/index.cjs"
            }
        },
        "./validate/node": {
            "import": {
                "types": "./dist/validate/node.d.ts",
                "default": "./dist/validate/node.js"
            },
            "require": {
                "types": "./dist/validate/node.d.cts",
                "default": "./dist/validate/node.cjs"
            }
        },
        "./context.jsonld": "./ontology/twb-house.context.jsonld",
        "./ontology/*": "./ontology/*",
        "./package.json": "./package.json"
    },
    "bin": {
        "twb": "./dist/cli.js"
    },
    "files": [
        "dist",
        "docs",
        "ontology",
        "LICENSE",
        "README.md"
    ],
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "build": "tsup",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "check:ontology": "python3 tools/twb_check.py && python3 tools/twb_house_check.py",
        "prepublishOnly": "npm run typecheck && npm test && npm run build"
    },
    "peerDependencies": {
        "lit": "^3.0.0",
        "three": ">=0.160.0"
    },
    "peerDependenciesMeta": {
        "lit": {
            "optional": true
        },
        "three": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/three": "^0.180.0",
        "lit": "^3.3.0",
        "oxigraph": "^0.5.11",
        "three": "^0.180.0",
        "tsup": "^8.5.0",
        "typescript": "~5.9.3",
        "vitest": "^4.0.0"
    },
    "module": "./dist/index.js",
    "typesVersions": {
        "*": {
            "house": [
                "dist/house/index.d.ts"
            ],
            "ifc": [
                "dist/ifc/index.d.ts"
            ],
            "elements": [
                "dist/elements/index.d.ts"
            ],
            "surfacekit/core": [
                "dist/surfacekit/core/index.d.ts"
            ],
            "surfacekit/grid": [
                "dist/surfacekit/grid/index.d.ts"
            ],
            "surfacekit/model": [
                "dist/surfacekit/model/index.d.ts"
            ],
            "surfacekit/interaction": [
                "dist/surfacekit/interaction/index.d.ts"
            ],
            "surfacekit/render": [
                "dist/surfacekit/render/index.d.ts"
            ],
            "validate": [
                "dist/validate/index.d.ts"
            ],
            "validate/node": [
                "dist/validate/node.d.ts"
            ]
        }
    }
}
