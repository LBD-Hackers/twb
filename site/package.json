{
    "name": "twb-site",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "description": "The TWB data model, documented and validated in the browser: https://lbd-hackers.github.io/twb/",
    "scripts": {
        "ontology": "node scripts/capture-ontology.mjs && node scripts/capture-reference.mjs",
        "dev": "npm run ontology && vite",
        "build": "npm run ontology && tsc --noEmit && vite build",
        "preview": "vite preview",
        "test": "vitest run"
    },
    "dependencies": {
        "d3-force": "^3.0.0",
        "lit": "^3.3.0",
        "oxigraph": "^0.5.11",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "three": "^0.180.0"
    },
    "devDependencies": {
        "@types/d3-force": "^3.0.10",
        "@types/node": "^22.0.0",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@types/three": "^0.180.0",
        "@vitejs/plugin-react": "^4.7.0",
        "typescript": "~5.9.3",
        "vite": "^6.0.11",
        "vitest": "^4.0.0"
    }
}
