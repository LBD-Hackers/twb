# CQ1: Which recipe does each surface carry, and which zones does its inside side face?
PREFIX twb: <https://w3id.org/twb#>
PREFIX bot: <https://w3id.org/bot#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX inst: <https://example.org/twb/case-house/>
SELECT ?surface ?kind ?recipe (GROUP_CONCAT(DISTINCT ?zoneLabel; separator=", ") AS ?insideFaces)
WHERE {
  ?s twb:hasRecipe/rdfs:label ?recipe ; rdfs:label ?surface ; a ?k .
  ?k rdfs:subClassOf twb:Surface ; rdfs:label ?kind .
  ?s twb:positiveSide|twb:negativeSide ?side . ?side twb:isInside true ; twb:facesZone ?z .
  OPTIONAL { ?z rdfs:label ?zl }
  BIND (COALESCE(STR(?zl), STR(?z)) AS ?zoneLabel)
}
GROUP BY ?surface ?kind ?recipe ORDER BY ?kind ?surface
