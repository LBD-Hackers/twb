# CQ2: What is the exterior wall's build-up, inside to outside, and which layer is the core?
PREFIX twb: <https://w3id.org/twb#>
PREFIX bot: <https://w3id.org/bot#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX inst: <https://example.org/twb/case-house/>
SELECT ?index ?material ?thickness ?core ?members
WHERE {
  <https://example.org/twb/case-house/recipe/exteriorWall> twb:hasLayer ?l .
  ?l twb:layerIndex ?index ; twb:material/rdfs:label ?material ; twb:thickness ?thickness ; twb:isCore ?core .
  OPTIONAL { ?l twb:hasMemberPattern ?mp . ?mp twb:memberWidth ?w ; twb:spacing ?cc .
             BIND (CONCAT(STR(?w), " mm @ ", STR(?cc), " mm") AS ?members) }
}
ORDER BY ?index
