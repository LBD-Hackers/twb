# CQ7: Which surfaces bound the bathroom, on which of their sides, over what area?
PREFIX twb: <https://w3id.org/twb#>
PREFIX bot: <https://w3id.org/bot#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX inst: <https://example.org/twb/case-house/>
SELECT ?surface ?kind ?side ?areaM2
WHERE {
  ?zb a twb:ZoneBoundary ; bot:interfaceOf <https://example.org/twb/case-house/zone/z-bath>, ?s ; twb:onSide ?sd ; twb:area ?areaM2 .
  ?s rdfs:label ?surface ; a ?k . ?k rdfs:subClassOf twb:Surface ; rdfs:label ?kind .
  OPTIONAL { ?sd twb:isInside ?inside }
  BIND (IF(BOUND(?inside), IF(?inside, "inside", "outside"), "-") AS ?side)
}
ORDER BY ?kind ?surface
