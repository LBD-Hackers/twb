# CQ11: How many edges does the house have, and how many distinct joint details detail all the typed ones?
PREFIX twb: <https://w3id.org/twb#>
PREFIX bot: <https://w3id.org/bot#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX inst: <https://example.org/twb/case-house/>
SELECT (COUNT(DISTINCT ?e) AS ?typedEdges) (COUNT(DISTINCT ?key) AS ?distinctDetails)
WHERE {
  ?e twb:edgeType ?t ; twb:isInsideCorner ?in ; twb:hasRoleAssignment ?a1, ?a2 .
  ?a1 twb:role twb:FirstRole ; twb:surface/twb:hasRecipe ?r1 .
  ?a2 twb:role twb:SecondRole ; twb:surface/twb:hasRecipe ?r2 .
  BIND (CONCAT(STR(?t), "|", STR(?in), "|", STR(?r1), "|", STR(?r2)) AS ?key)
}
