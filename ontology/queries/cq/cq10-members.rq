# CQ10: Which members were derived from each surface, by role, and how much timber is that?
PREFIX twb: <https://w3id.org/twb#>
PREFIX bot: <https://w3id.org/bot#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX inst: <https://example.org/twb/case-house/>
SELECT ?surface ?role (COUNT(?m) AS ?members) (ROUND(SUM(?len) / 100) / 10 AS ?metres)
WHERE {
  ?m a twb:Member ; twb:derivedFrom/rdfs:label ?surface ; twb:memberRole/skos:prefLabel ?role ; twb:length ?len .
}
GROUP BY ?surface ?role ORDER BY ?surface DESC(?members)
