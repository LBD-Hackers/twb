# -----------------------------------------------------------------------------------------------
# Building uses per national profile (envelope/building-use.ts)
# -----------------------------------------------------------------------------------------------

<https://w3id.org/twb/catalogue/arch#use/DK/shed-unheated>
    a twb:BuildingUse ;
    skos:prefLabel "Uninsulated shed"@en ;
    skos:notation "shed-unheated" ;
    skos:definition "Not heated: a tool shed, a woodshed, a garage. BR18 § 254 asks no insulation of it, and it is outside the energy frame. Bare studs, boards straight on them."@en ;
    twb:nationalProfile "DK (BR18)" .

<https://w3id.org/twb/catalogue/arch#use/DK/shed-insulated>
    a twb:BuildingUse ;
    skos:prefLabel "Insulated shed or garden house"@en ;
    skos:notation "shed-insulated" ;
    skos:definition "Heated to between 5 and 15 °C: a frost-free workshop or a hobby room. A heated building meets BR18 § 257’s minimums and § 264’s transmission loss, designed at 15 °C (§ 260, stk. 2). Lived in and heated to room temperature, it is a house."@en ;
    twb:nationalProfile "DK (BR18)" .

<https://w3id.org/twb/catalogue/arch#use/DK/summer-house>
    a twb:BuildingUse ;
    skos:prefLabel "Summer house"@en ;
    skos:notation "summer-house" ;
    skos:definition "A holiday home. BR18 § 283, tabel 4: walls 0.25, roof and floor 0.15 W/m²K, windows and doors 1.80 — while they are at most 30 % of the floor (§ 284). No energy frame and no transmission loss limit."@en ;
    twb:nationalProfile "DK (BR18)" .

<https://w3id.org/twb/catalogue/arch#use/DK/dwelling>
    a twb:BuildingUse ;
    skos:prefLabel "Year-round house"@en ;
    skos:notation "dwelling" ;
    skos:definition "A house lived in all year. BR18 § 257, tabel 1: walls 0.30, roof and floor 0.20 W/m²K; and § 264: the design transmission loss, windows and doors included, at most 12 + 6/E + 300/A W per m² of heated floor."@en ;
    twb:nationalProfile "DK (BR18)" .


# -----------------------------------------------------------------------------------------------
# Construction systems (envelope/construction-system.ts)
# -----------------------------------------------------------------------------------------------

<https://w3id.org/twb/catalogue/arch#system/timber-frame>
    a twb:ConstructionSystem ;
    skos:prefLabel "Timber frame"@en ;
    skos:notation "timber-frame" ;
    skos:definition "Studs, rafters and joists derived and sized by Framing, insulated between, on a timber deck over a ventilated crawl space. Set out on the sheet module: 600 and 400."@en .

<https://w3id.org/twb/catalogue/arch#system/masonry>
    a twb:ConstructionSystem ;
    skos:prefLabel "Masonry"@en ;
    skos:notation "masonry" ;
    skos:definition "A cavity wall: aerated concrete blocks inside, mineral wool with stainless ties in the cavity, facing brick outside. A ground slab on a strip foundation; the roof on a wall plate anchored to the inner leaf. Set out on the brick module: 240 and 120."@en .


# -----------------------------------------------------------------------------------------------
# Floor and roof structures of a heavy house (envelope/concrete-slabs.ts)
# -----------------------------------------------------------------------------------------------

<https://w3id.org/twb/catalogue/arch#floor-structure/timber>
    a twb:FloorStructure ;
    skos:prefLabel "Timber joists"@en ;
    skos:notation "timber" ;
    skos:definition "Joists derived and sized by Framing, mineral wool between them for the sound, floorboards over and plasterboard under. Light, and quick to build."@en .

<https://w3id.org/twb/catalogue/arch#floor-structure/cast-concrete>
    a twb:FloorStructure ;
    skos:prefLabel "Cast concrete"@en ;
    skos:notation "cast-concrete" ;
    skos:definition "A reinforced slab of 200, cast in place on the inner leaves, with a floating floor of boards on impact-sound insulation. Heavy, quiet and stiff; spans to about 5 m between bearing walls."@en .

<https://w3id.org/twb/catalogue/arch#floor-structure/hollow-core>
    a twb:FloorStructure ;
    skos:prefLabel "Hollow-core slabs"@en ;
    skos:notation "hollow-core" ;
    skos:definition "Prestressed hollow-core elements of 220, 1200 wide, craned onto the inner leaves and grouted, levelled with a screed under a floating floor. Spans to about 9 m with no propping."@en .

<https://w3id.org/twb/catalogue/arch#roof-structure/timber>
    a twb:RoofStructure ;
    skos:prefLabel "Timber"@en ;
    skos:notation "timber" ;
    skos:definition "Rafters or trusses on a wall plate anchored to the inner leaf, insulated between and under them."@en .

<https://w3id.org/twb/catalogue/arch#roof-structure/cast-concrete>
    a twb:RoofStructure ;
    skos:prefLabel "Cast concrete"@en ;
    skos:notation "cast-concrete" ;
    skos:definition "A slab of 200 cast on the inner leaves, insulated on top: a vapour barrier, insulation and the covering over it — on a flat roof, tapered for the fall."@en .

<https://w3id.org/twb/catalogue/arch#roof-structure/hollow-core>
    a twb:RoofStructure ;
    skos:prefLabel "Hollow-core slabs"@en ;
    skos:notation "hollow-core" ;
    skos:definition "Prestressed hollow-core elements of 220 on the inner leaves, insulated on top as a cast roof is. Spans to about 9 m with no propping."@en .


# -----------------------------------------------------------------------------------------------
# Brick bonds of a facing leaf (envelope/brick-bond.ts)
# -----------------------------------------------------------------------------------------------

<https://w3id.org/twb/catalogue/arch#bond/stretcher>
    a twb:BrickBond ;
    skos:prefLabel "Løberforbandt"@da ;
    skos:notation "stretcher" ;
    skos:definition "Stretchers only, each course half a brick on from the one below. What nearly every Danish cavity wall is laid in."@en ;
    rdfs:comment "The default bond of a facing leaf." .

<https://w3id.org/twb/catalogue/arch#bond/cross>
    a twb:BrickBond ;
    skos:prefLabel "Krydsforbandt"@da ;
    skos:notation "cross" ;
    skos:definition "A course of stretchers and a course of headers in turn, every other stretcher course moved half a brick, so the joints draw crosses."@en .

<https://w3id.org/twb/catalogue/arch#bond/block>
    a twb:BrickBond ;
    skos:prefLabel "Blokforbandt"@da ;
    skos:notation "block" ;
    skos:definition "Stretchers and headers in turn, the stretcher courses over one another and the headers centred on their joints and their middles."@en .

<https://w3id.org/twb/catalogue/arch#bond/monk>
    a twb:BrickBond ;
    skos:prefLabel "Munkeforbandt"@da ;
    skos:notation "monk" ;
    skos:definition "Two stretchers and a header in every course, each header over the joint between the two stretchers below."@en .

<https://w3id.org/twb/catalogue/arch#bond/flemish>
    a twb:BrickBond ;
    skos:prefLabel "Polsk forbandt"@da ;
    skos:notation "flemish" ;
    skos:definition "A stretcher and a header in turn in every course, each header centred over the stretcher below."@en .
