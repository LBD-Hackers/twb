<https://w3id.org/twb/catalogue/arch#role/head-rail>
    a twb:MemberRole ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#MemberRoles> ;
    skos:prefLabel "Head rail"@en ;
    skos:notation "head-rail" ;
    twb:ifcCounterpart "IfcMember.MEMBER" ;
