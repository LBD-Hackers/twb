    skos:prefLabel "Foundation pillar"@en ;
    skos:notation "pillar" ;
    twb:ifcCounterpart "IfcColumn.COLUMN" ;
    rdfs:comment "Structural." .

<https://w3id.org/twb/catalogue/arch#role/free-beam>
    a twb:MemberRole ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#MemberRoles> ;
    skos:prefLabel "Beam"@en ;
    skos:notation "free-beam" ;
