# -----------------------------------------------------------------------------------------------
# Fixture variants (apps/frame-builder/src/room-fixtures/fixtures.ts, FIXTURE_VARIANTS; #251)
# -----------------------------------------------------------------------------------------------

<https://w3id.org/twb/catalogue/arch#FixtureVariants>
    a skos:ConceptScheme ;
    skos:prefLabel "arch fixture variants"@en .

<https://w3id.org/twb/catalogue/arch#fixture-variant/floor-standing>
    a twb:FixtureVariant ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FixtureVariants> ;
    skos:prefLabel "Floor-standing"@en ;
    skos:notation "floor-standing" ;
    skos:definition "A WC whose cistern stands on the bowl. The default."@en ;
    twb:variantOf <https://w3id.org/twb/catalogue/arch#fixture-kind/wc> .

<https://w3id.org/twb/catalogue/arch#fixture-variant/wall-hung>
    a twb:FixtureVariant ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FixtureVariants> ;
    skos:prefLabel "Wall-hung"@en ;
    skos:notation "wall-hung" ;
    skos:definition "Hung on the wall: a WC on an installation wall that hides its cistern, a basin alone on the wall. The basin's default."@en ;
    twb:variantOf <https://w3id.org/twb/catalogue/arch#fixture-kind/wc>, <https://w3id.org/twb/catalogue/arch#fixture-kind/basin> .

<https://w3id.org/twb/catalogue/arch#fixture-variant/vanity>
    a twb:FixtureVariant ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FixtureVariants> ;
    skos:prefLabel "On a vanity unit"@en ;
    skos:notation "vanity" ;
    skos:definition "A basin set in a cabinet that stands on the floor (møbelvask), so it covers the floor under it."@en ;
    twb:variantOf <https://w3id.org/twb/catalogue/arch#fixture-kind/basin> .

<https://w3id.org/twb/catalogue/arch#fixture-variant/built-in>
    a twb:FixtureVariant ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FixtureVariants> ;
    skos:prefLabel "Built-in"@en ;
    skos:notation "built-in" ;
    skos:definition "A bathtub against the walls, panelled in. The default."@en ;
    twb:variantOf <https://w3id.org/twb/catalogue/arch#fixture-kind/bathtub> .

<https://w3id.org/twb/catalogue/arch#fixture-variant/freestanding>
    a twb:FixtureVariant ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FixtureVariants> ;
    skos:prefLabel "Freestanding"@en ;
    skos:notation "freestanding" ;
    skos:definition "A bathtub free of the walls, on feet, leaving the floor under it free."@en ;
    twb:variantOf <https://w3id.org/twb/catalogue/arch#fixture-kind/bathtub> .

<https://w3id.org/twb/catalogue/arch#fixture-variant/unidrain>
    a twb:FixtureVariant ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FixtureVariants> ;
    skos:prefLabel "Linear drain (Unidrain)"@en ;
    skos:notation "unidrain" ;
    skos:definition "A linear floor drain along a wall of the shower, 700–1200 long. The default."@en ;
    twb:variantOf <https://w3id.org/twb/catalogue/arch#fixture-kind/floor-drain> .

<https://w3id.org/twb/catalogue/arch#fixture-variant/point>
    a twb:FixtureVariant ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FixtureVariants> ;
    skos:prefLabel "Point drain (Blücher)"@en ;
    skos:notation "point" ;
    skos:definition "A point floor drain, about 150 square, the floor falling to it from every side."@en ;
    twb:variantOf <https://w3id.org/twb/catalogue/arch#fixture-kind/floor-drain> .


