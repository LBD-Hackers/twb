# -----------------------------------------------------------------------------------------------
# Framing rule topics and options (recipe/framing-rules.ts, FRAMING_RULE_TOPICS)
# -----------------------------------------------------------------------------------------------

<https://w3id.org/twb/catalogue/arch#FramingRules>
    a skos:ConceptScheme ;
    skos:prefLabel "arch framing rules"@en .

<https://w3id.org/twb/catalogue/arch#topic/wall-corner-precedence>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Which wall runs through a corner"@en ;
    skos:notation "wall-corner-precedence" ;
    skos:definition "Where two walls meet at a corner one runs through and the other butts against it. This decides which, and so which wall is a module longer on the cutting list."@en ;
    dcterms:subject "walls" .

<https://w3id.org/twb/catalogue/arch#option/wall-corner-precedence/rank>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/wall-corner-precedence> ;
    skos:prefLabel "Exterior, then bearing, then longer"@en ;
    skos:notation "rank" ;
    skos:definition "An exterior wall beats a partition, a bearing wall beats a gable, and only then does the longer wall win."@en ;
    twb:isDefaultOption true ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/wall-corner-precedence/longer>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/wall-corner-precedence> ;
    skos:prefLabel "Longer wall runs through"@en ;
    skos:notation "longer" ;
    skos:definition "Length alone decides — fewer, longer elements on the line, whichever kind of wall they are."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#topic/wall-corner-detail>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Corner detail"@en ;
    skos:notation "wall-corner-detail" ;
    skos:definition "How the two walls at a corner are joined to each other."@en ;
    dcterms:subject "walls" .

<https://w3id.org/twb/catalogue/arch#option/wall-corner-detail/butt>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/wall-corner-detail> ;
    skos:prefLabel "Butt joint, screwed"@en ;
    skos:notation "butt" ;
    skos:definition "The butting wall’s end stud is screwed to the through wall; with a double top plate the upper layer laps the corner the other way."@en ;
    twb:isDefaultOption true ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/wall-corner-detail/plate-half-lap>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/wall-corner-detail> ;
    skos:prefLabel "Half-lapped plates"@en ;
    skos:notation "plate-half-lap" ;
    skos:definition "Top and bottom plates halved into each other (halvtræ) so the corner locks without relying on the screws."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/Lap> ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#option/wall-corner-detail/three-stud-corner>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/wall-corner-detail> ;
    skos:prefLabel "Three-stud corner"@en ;
    skos:notation "three-stud-corner" ;
    skos:definition "An extra stud in the through wall gives the inside lining something to fix to — the insulated-corner alternative to a backing stud."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#topic/top-plate-layers>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Top plate under rafters"@en ;
    skos:notation "top-plate-layers" ;
    skos:definition "Rafters land between studs, so the top plate spans between them. Trussed roofs are set out to land on the studs and always get a single plate."@en ;
    dcterms:subject "walls" .

<https://w3id.org/twb/catalogue/arch#option/top-plate-layers/double>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/top-plate-layers> ;
    skos:prefLabel "Double top plate"@en ;
    skos:notation "double" ;
    skos:definition "Two plates, the upper lapping the corners — stiff enough to span c/c."@en ;
    twb:isDefaultOption true ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/top-plate-layers/single>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/top-plate-layers> ;
    skos:prefLabel "Single top plate"@en ;
    skos:notation "single" ;
    skos:definition "One plate, for when the rafters are set out over the studs (or a steel strap takes the corner)."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#topic/stud-to-plate>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Stud to plate"@en ;
    skos:notation "stud-to-plate" ;
    skos:definition "How each stud meets the top and bottom plates."@en ;
    dcterms:subject "walls" .

<https://w3id.org/twb/catalogue/arch#option/stud-to-plate/butt>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/stud-to-plate> ;
    skos:prefLabel "Butt joint, screwed"@en ;
    skos:notation "butt" ;
    skos:definition "Square-cut stud screwed through the plate. The standard element."@en ;
    twb:isDefaultOption true ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/JackRafterCut> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/stud-to-plate/tenon>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/stud-to-plate> ;
    skos:prefLabel "Tenon and mortise"@en ;
    skos:notation "tenon" ;
    skos:definition "A tenon on the stud into a mortise in the plate — locates every stud on the machine, not on the table."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/Tenon>, <https://w3id.org/twb/catalogue/arch#processing/Mortise> ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#option/stud-to-plate/housed>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/stud-to-plate> ;
    skos:prefLabel "Housed into plate"@en ;
    skos:notation "housed" ;
    skos:definition "A shallow housing in the plate the stud end sits in."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/House> ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#topic/stud-to-rake-plate>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Stud under a rake plate"@en ;
    skos:notation "stud-to-rake-plate" ;
    skos:definition "On a gable, each stud stops under the sloping plate. A square end only touches it on one arris."@en ;
    dcterms:subject "walls" .

<https://w3id.org/twb/catalogue/arch#option/stud-to-rake-plate/angled-cut>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/stud-to-rake-plate> ;
    skos:prefLabel "Angled cut to the plate"@en ;
    skos:notation "angled-cut" ;
    skos:definition "Each stud’s top is cut to the plate’s own soffit, so it bears across its full width."@en ;
    twb:isDefaultOption true ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/JackRafterCut> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/stud-to-rake-plate/housed>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/stud-to-rake-plate> ;
    skos:prefLabel "Housed into the rake plate"@en ;
    skos:notation "housed" ;
    skos:definition "Angled cut, and each stud drops into a shallow pocket milled in the plate’s soffit — the plate sets the studs out, and they cannot creep while screwed."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/JackRafterCut>, <https://w3id.org/twb/catalogue/arch#processing/Lap> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/stud-to-rake-plate/square>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/stud-to-rake-plate> ;
    skos:prefLabel "Square end"@en ;
    skos:notation "square" ;
    skos:definition "Studs cut square at their centreline height: the downhill corner runs into the plate, the uphill one leaves a gap."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/stud-to-rake-plate/tenon>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/stud-to-rake-plate> ;
    skos:prefLabel "Angled tenon"@en ;
    skos:notation "tenon" ;
    skos:definition "An angled tenon into a mortise in the rake plate."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/Tenon>, <https://w3id.org/twb/catalogue/arch#processing/Mortise> ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#topic/header-to-king>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Header to king stud"@en ;
    skos:notation "header-to-king" ;
    skos:definition "How a door or window header is carried by the studs either side of it."@en ;
    dcterms:subject "openings" .

<https://w3id.org/twb/catalogue/arch#option/header-to-king/housed>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/header-to-king> ;
    skos:prefLabel "Housed into the kings"@en ;
    skos:notation "housed" ;
    skos:definition "The header runs into a housing in each king stud; the bottom of the housing is its bearing. No trimmers."@en ;
    twb:isDefaultOption true ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/Lap> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/header-to-king/trimmers>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/header-to-king> ;
    skos:prefLabel "On trimmer studs"@en ;
    skos:notation "trimmers" ;
    skos:definition "A trimmer stud beside each king carries the header on its end grain — more timber, no housing."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#topic/joist-over-beam>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Joist over a beam"@en ;
    skos:notation "joist-over-beam" ;
    skos:definition "Where a joist crosses a beam that breaks its span — the beam on pillars down a long ground floor, or the short one under a post."@en ;
    dcterms:subject "floors" .

<https://w3id.org/twb/catalogue/arch#option/joist-over-beam/notched>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/joist-over-beam> ;
    skos:prefLabel "Notched over the beam"@en ;
    skos:notation "notched" ;
    skos:definition "Udhak: every joist is notched down over the beam, which comes up into the joist zone by the notch depth. The notch locates each joist on the beam and holds it square, and the floor gets that much shallower."@en ;
    twb:isDefaultOption true ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/Lap> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/joist-over-beam/on-top>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/joist-over-beam> ;
    skos:prefLabel "Laid on top"@en ;
    skos:notation "on-top" ;
    skos:definition "The joists bear on the beam uncut, and are fixed to it with a skew nail or an angle bracket. The beam hangs its full depth under the joists."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/joist-over-beam/hanger>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/joist-over-beam> ;
    skos:prefLabel "Flush, in hangers"@en ;
    skos:notation "hanger" ;
    skos:definition "The beam flush with the joists, and each joist hung off its side in a joist hanger (bjælkesko). No drop under the floor, but a bracket per joist."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#topic/rafter-at-eave>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Rafter on the wall plate"@en ;
    skos:notation "rafter-at-eave" ;
    skos:definition "Where each rafter lands on the eave wall’s top plate."@en ;
    dcterms:subject "roof-joints" .

<https://w3id.org/twb/catalogue/arch#option/rafter-at-eave/birdsmouth>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/rafter-at-eave> ;
    skos:prefLabel "Birdsmouth (fuglemund)"@en ;
    skos:notation "birdsmouth" ;
    skos:definition "A seat and heel cut into the rafter where it crosses the plate, read off the plate’s own top and outer faces — the overhang keeps its full section."@en ;
    twb:isDefaultOption true ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/Birdsmouth> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/rafter-at-eave/bracket>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/rafter-at-eave> ;
    skos:prefLabel "No cut, fixed with a bracket"@en ;
    skos:notation "bracket" ;
    skos:definition "The rafter sits on the plate and is fixed with a spærbeslag."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#topic/rafter-on-ridge-beam>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Rafter on a ridge beam"@en ;
    skos:notation "rafter-on-ridge-beam" ;
    skos:definition "Where a rafter bears on the ridge beam of a roof open to the ridge."@en ;
    dcterms:subject "roof-joints" .

<https://w3id.org/twb/catalogue/arch#option/rafter-on-ridge-beam/birdsmouth>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/rafter-on-ridge-beam> ;
    skos:prefLabel "Birdsmouth on the beam"@en ;
    skos:notation "birdsmouth" ;
    skos:definition "The rafter is notched over the beam; the beam is lowered so the notch is the target depth whatever the pitch."@en ;
    twb:isDefaultOption true ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/StepJoint> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/rafter-on-ridge-beam/hanger>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/rafter-on-ridge-beam> ;
    skos:prefLabel "Plumb cut into a hanger"@en ;
    skos:notation "hanger" ;
    skos:definition "The rafter stops at the beam’s side face and hangs in a bjælkesko — the beam can then sit flush with the rafters."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/JackRafterCut> ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#topic/rafter-at-ridge-board>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Rafter at a ridge board"@en ;
    skos:notation "rafter-at-ridge-board" ;
    skos:definition "Where rafter pairs meet at a ridge with no beam under it."@en ;
    dcterms:subject "roof-joints" .

<https://w3id.org/twb/catalogue/arch#option/rafter-at-ridge-board/plumb-cut>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/rafter-at-ridge-board> ;
    skos:prefLabel "Plumb cut"@en ;
    skos:notation "plumb-cut" ;
    skos:definition "Each rafter cut vertical at the ridge, against the ridge board."@en ;
    twb:isDefaultOption true ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/JackRafterCut> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/rafter-at-ridge-board/french-ridge-lap>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/rafter-at-ridge-board> ;
    skos:prefLabel "French ridge lap"@en ;
    skos:notation "french-ridge-lap" ;
    skos:definition "The pair halved over each other at the apex, with no ridge board."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/FrenchRidgeLap> ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#topic/rafter-over-purlin>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Rafter over a purlin"@en ;
    skos:notation "rafter-over-purlin" ;
    skos:definition "Where a rafter crosses a mid-slope purlin (drager)."@en ;
    dcterms:subject "roof-joints" .

<https://w3id.org/twb/catalogue/arch#option/rafter-over-purlin/lap-pocket>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/rafter-over-purlin> ;
    skos:prefLabel "Rectangular notch"@en ;
    skos:notation "lap-pocket" ;
    skos:definition "A fixed-depth pocket in the rafter’s soffit over the purlin."@en ;
    twb:isDefaultOption true ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/Lap> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/rafter-over-purlin/birdsmouth>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/rafter-over-purlin> ;
    skos:prefLabel "Angled notch"@en ;
    skos:notation "birdsmouth" ;
    skos:definition "A true angled seat on the level purlin, mid-span."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/StepJointNotch> ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#topic/hip-valley-jack>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Jack rafters at hips and valleys"@en ;
    skos:notation "hip-valley-jack" ;
    skos:definition "Where a rafter runs into a hip or valley rafter."@en ;
    dcterms:subject "roof-joints" .

<https://w3id.org/twb/catalogue/arch#option/hip-valley-jack/uncut>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/hip-valley-jack> ;
    skos:prefLabel "Uncut (current limitation)"@en ;
    skos:notation "uncut" ;
    skos:definition "Jack rafters stop at the hip line uncut — fitted on site."@en ;
    twb:isDefaultOption true ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/hip-valley-jack/compound-cut>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/hip-valley-jack> ;
    skos:prefLabel "Compound cut"@en ;
    skos:notation "compound-cut" ;
    skos:definition "Plumb and side bevel in one cut, and the hip’s own ridge-valley cut."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/DoubleCut>, <https://w3id.org/twb/catalogue/arch#processing/RidgeValleyCut> ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#topic/roof-structure>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Rafters or trusses"@en ;
    skos:notation "roof-structure" ;
    skos:definition "What carries a roof tied by a flat ceiling at the eaves: factory W-trusses, or rafters with collar ties and ceiling joists. A truss is only made for a plain, symmetric duopitch of 15–45° without roof windows; anywhere else it is rafters."@en ;
    dcterms:subject "rafters-trusses" .

<https://w3id.org/twb/catalogue/arch#option/roof-structure/prefer-trusses>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/roof-structure> ;
    skos:prefLabel "W-trusses wherever they fit"@en ;
    skos:notation "prefer-trusses" ;
    skos:definition "The Danish standard over a flat ceiling: factory nail-plate W-trusses wherever the roof allows, documented by their manufacturer — tied rafters where it does not, or where the rafter section is pinned."@en ;
    twb:isDefaultOption true ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/roof-structure/auto>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/roof-structure> ;
    skos:prefLabel "Whichever takes less timber"@en ;
    skos:notation "auto" ;
    skos:definition "W-trusses where they save at least 5% of the timber tied rafters would take, tied rafters otherwise — or where the rafter section is pinned."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/roof-structure/rafters>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/roof-structure> ;
    skos:prefLabel "Tied rafters (hanebåndsspær)"@en ;
    skos:notation "rafters" ;
    skos:definition "A rafter pair with a collar tie, and a ceiling joist across the feet — cut and raised on site."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/roof-structure/trusses>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/roof-structure> ;
    skos:prefLabel "W-trusses, even without a ceiling"@en ;
    skos:notation "trusses" ;
    skos:definition "Factory trusses wherever the roof allows, even with no ceiling drawn — the bottom chords are then the ceiling."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#topic/truss-type>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Truss type"@en ;
    skos:notation "truss-type" ;
    skos:definition "Which factory truss carries a trussed roof. All are nail-plated (hulplader) at every joint and designed, documented and marked by their manufacturer; the app sizes one so the quote is a confirmation and the take-off is honest."@en ;
    dcterms:subject "rafters-trusses" .

<https://w3id.org/twb/catalogue/arch#option/truss-type/w-truss>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/truss-type> ;
    skos:prefLabel "W-truss (W-spær)"@en ;
    skos:notation "w-truss" ;
    skos:definition "The stock Danish truss over a flat ceiling: a Fink pattern whose webs brace each top chord at its quarter points and hang the ceiling at the bottom chord’s thirds. Up to a 12 m span here."@en ;
    twb:isDefaultOption true ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/truss-type/double-w>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/truss-type> ;
    skos:prefLabel "Double W-truss"@en ;
    skos:notation "double-w" ;
    skos:definition "Twice the webs, for spans past where a single W’s panels grow too long."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#option/truss-type/scissor>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/truss-type> ;
    skos:prefLabel "Scissor truss (saksespær)"@en ;
    skos:notation "scissor" ;
    skos:definition "A bottom chord that rises toward the middle, for a sloping ceiling with no ridge beam and no thrust on the walls."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#option/truss-type/attic>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/truss-type> ;
    skos:prefLabel "Attic truss (rumspær)"@en ;
    skos:notation "attic" ;
    skos:definition "A room framed into the truss — floor joist, knee walls and a collar ceiling — for a usable roof space."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#option/truss-type/mono>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/truss-type> ;
    skos:prefLabel "Mono-pitch truss (ensidigt spær)"@en ;
    skos:notation "mono" ;
    skos:definition "Half a truss, for a lean-to or a monopitch roof."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#topic/collar-tie>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Collar tie (hanebånd)"@en ;
    skos:notation "collar-tie" ;
    skos:definition "How the collar tie is joined to each rafter pair in a tied rafter roof. The rafters are sized whole, so a joint that cuts into them takes strength the sizing counted on."@en ;
    dcterms:subject "rafters-trusses" .

<https://w3id.org/twb/catalogue/arch#option/collar-tie/paired-boards>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/collar-tie> ;
    skos:prefLabel "Paired boards, nailed (dobbelt hanebånd)"@en ;
    skos:notation "paired-boards" ;
    skos:definition "A board against each face of the rafter pair, nailed or screwed through both, ends cut flush with the roof plane. The rafter keeps its full section, and the pair pulls neither rafter out of its plane."@en ;
    twb:isDefaultOption true ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/JackRafterCut> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/collar-tie/side-fixed>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/collar-tie> ;
    skos:prefLabel "One board, side-fixed"@en ;
    skos:notation "side-fixed" ;
    skos:definition "One board against one face of both rafters, screwed or bolted through — the rafter is uncut, but the joint is eccentric."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/JackRafterCut> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/collar-tie/half-lap>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/collar-tie> ;
    skos:prefLabel "Straight half lap, pegged"@en ;
    skos:notation "half-lap" ;
    skos:definition "Lige blad: collar and rafter halved into each other with square shoulders, locked with an oak peg. Takes half the rafter’s width out where it bends nearly the most — flagged when the rafter cannot spare it."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/FreeContour>, <https://w3id.org/twb/catalogue/arch#processing/Drilling> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/collar-tie/dovetail-lap>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/collar-tie> ;
    skos:prefLabel "Dovetail lap, pegged"@en ;
    skos:notation "dovetail-lap" ;
    skos:definition "Svalehaleblad: as the half lap, the collar’s tongue widening toward its end so it cannot pull out — traditional carpentry, and the same loss of rafter section."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/FreeContour>, <https://w3id.org/twb/catalogue/arch#processing/Drilling> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#topic/glulam-use>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Glulam (limtræ)"@en ;
    skos:notation "glulam-use" ;
    skos:definition "Whether the ridge beam, purlin and flat-deck joists may be glulam. Rafters are sawn in Auto regardless."@en ;
    dcterms:subject "roof-structure" .

<https://w3id.org/twb/catalogue/arch#option/glulam-use/cheapest>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/glulam-use> ;
    skos:prefLabel "Cheapest that passes"@en ;
    skos:notation "cheapest" ;
    skos:definition "Sawn, built-up and glulam compete on cost like everything else."@en ;
    twb:isDefaultOption true ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/glulam-use/avoid>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/glulam-use> ;
    skos:prefLabel "Avoid glulam"@en ;
    skos:notation "avoid" ;
    skos:definition "Sawn or built-up with any number of props first; glulam only if nothing else passes."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/glulam-use/never>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/glulam-use> ;
    skos:prefLabel "Never glulam"@en ;
    skos:notation "never" ;
    skos:definition "Sawn or built-up only — a warning where nothing passes."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#topic/ridge-support>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "How the ridge is carried"@en ;
    skos:notation "ridge-support" ;
    skos:definition "The beam or beams a roof open to the ridge hangs its rafters from."@en ;
    dcterms:subject "roof-structure" .

<https://w3id.org/twb/catalogue/arch#option/ridge-support/single-beam>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/ridge-support> ;
    skos:prefLabel "One ridge beam"@en ;
    skos:notation "single-beam" ;
    skos:definition "One kiprem, the cheapest section that passes."@en ;
    twb:isDefaultOption true ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/ridge-support/twin-beam>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/ridge-support> ;
    skos:prefLabel "Twin sawn ridge beam"@en ;
    skos:notation "twin-beam" ;
    skos:definition "Two or three sawn pieces side by side (2×45×…) where they reach — glulam only where they do not, and only if glulam is allowed."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/ridge-support/purlin-per-slope>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/ridge-support> ;
    skos:prefLabel "One purlin per slope"@en ;
    skos:notation "purlin-per-slope" ;
    skos:definition "A drager under the middle of each slope instead of a ridge beam, halving the rafter span."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/Lap> ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#topic/ridge-props>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Posts under the ridge"@en ;
    skos:notation "ridge-props" ;
    skos:definition "What breaks a long ridge beam’s span. Bearing interior walls under the ridge always do; a post stands in the room the open roof exists to make."@en ;
    dcterms:subject "roof-structure" .

<https://w3id.org/twb/catalogue/arch#option/ridge-props/walls-only>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/ridge-props> ;
    skos:prefLabel "Walls only, no posts"@en ;
    skos:notation "walls-only" ;
    skos:definition "The beam bears on the gables and on any bearing wall crossing under the ridge. Where that takes glulam — or nothing passes — a warning says where a bearing interior wall would help."@en ;
    twb:isDefaultOption true ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/ridge-props/cost-balanced>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/ridge-props> ;
    skos:prefLabel "Weigh posts against timber"@en ;
    skos:notation "cost-balanced" ;
    skos:definition "Posts may stand in the rooms too, each priced as a volume of timber, and the cheapest arrangement wins. A post runs down to the floor and gets a pillar and beam under it on the ground."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#topic/verge-construction>
    a twb:RuleTopic ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    skos:prefLabel "Verge overhang (udhæng ved gavl)"@en ;
    skos:notation "verge-construction" ;
    skos:definition "What carries the roof past the gable wall, out to the verge. The overhang itself is set in Framing settings, or per edge in the joint wizard."@en ;
    dcterms:subject "roof-structure" .

<https://w3id.org/twb/catalogue/arch#option/verge-construction/auto>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/verge-construction> ;
    skos:prefLabel "By the overhang"@en ;
    skos:notation "auto" ;
    skos:definition "Battens alone up to the batten limit, a verge ladder beyond it — and a warning past what a ladder is trusted with."@en ;
    twb:isDefaultOption true ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/JackRafterCut> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/verge-construction/ladder>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/verge-construction> ;
    skos:prefLabel "Verge ladder (gavlstige)"@en ;
    skos:notation "ladder" ;
    skos:definition "A barge rafter at the verge, held to the gable rafter by rungs square between them."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/JackRafterCut> ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/verge-construction/battens>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/verge-construction> ;
    skos:prefLabel "Battens only"@en ;
    skos:notation "battens" ;
    skos:definition "Nothing past the gable rafter: the battens run on and carry the barge board."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: active" .

<https://w3id.org/twb/catalogue/arch#option/verge-construction/outriggers>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/verge-construction> ;
    skos:prefLabel "Outriggers (udlæggere)"@en ;
    skos:notation "outriggers" ;
    skos:definition "Rungs laid over the gable, notched into it, back to the second rafter — for a deeper verge. The gable’s rake plate drops by a rafter’s depth."@en ;
    twb:isDefaultOption false ;
    twb:millsWith <https://w3id.org/twb/catalogue/arch#processing/Lap> ;
    rdfs:comment "status: planned" .

<https://w3id.org/twb/catalogue/arch#option/verge-construction/cantilevered-plates>
    a twb:RuleOption ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#FramingRules> ;
    twb:optionOf <https://w3id.org/twb/catalogue/arch#topic/verge-construction> ;
    skos:prefLabel "Ridge and plates run on"@en ;
    skos:notation "cantilevered-plates" ;
    skos:definition "The ridge beam and the eave plates cantilever past the gable and carry the barge rafter — the deep verge of a roof on a ridge beam."@en ;
    twb:isDefaultOption false ;
    rdfs:comment "status: planned" .


