<https://w3id.org/twb/catalogue/arch#role/sill>
    a twb:MemberRole ;
    skos:inScheme <https://w3id.org/twb/catalogue/arch#MemberRoles> ;
    skos:prefLabel "Sill"@en ;
    skos:notation "sill" ;
    twb:ifcCounterpart "IfcBeam.BEAM" ;
    rdfs:comment "Structural." .

<https://w3id.org/twb/catalogue/arch#role/pillar>
