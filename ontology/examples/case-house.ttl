# The TWB case house, exported from arch 5cc0b38 by tools/blueprint-rdf.harness.ts.
# Authored (case-house.input.json): walls in plan, openings by centre, roof by type and pitch, partitions
#   with their doors, rooms, standards, expression, building use; then a template, one own joint, one own
#   opening finish and one node rule.
# Derived by arch: faces, kinds, ceilings and the attic, rooms, recipes, sides, edges, roles, expression
#   trims, nodes, passages, members.
# {"surfaces":14,"authoredSurfaces":11,"ceilings":1,"edges":40,"tees":22,"nodes":6,"nodeRules":1,"passages":4,"members":298,"rooms":4,"attics":1,"dressed":14}
@prefix twb:  <https://w3id.org/twb#> .
@prefix twbc: <https://w3id.org/twb/catalogue/arch#> .
@prefix inst: <https://example.org/twb/case-house/> .
@prefix bot:  <https://w3id.org/bot#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .


# -----------------------------------------------------------------------------------------------
# Blueprint, building and storeys (arch 5cc0b38)
# -----------------------------------------------------------------------------------------------

<https://example.org/twb/case-house/blueprint>
    a twb:Blueprint ;
    rdfs:label "TWB case house"@en ;
    rdfs:comment "TWB case house: 7.2 x 9.6 m single-storey timber-frame house, 2400 mm walls, a 30-degree gable roof with its ridge along y, three partitions with a door each and four rooms, all ceiled flat under a cold attic." ;
    dcterms:source "arch 5cc0b38" ;
    twb:describesBuilding <https://example.org/twb/case-house/building> ;
    twb:defaultEavesOverhang 500.0 ;
    twb:defaultVergeOverhang 400.0 ;
    twb:hasExpression <https://example.org/twb/case-house/expression> ;
    twb:hasBuildingUse <https://w3id.org/twb/catalogue/arch#use/DK/dwelling> ;
    twb:roofLoadProfile "heavy" ;
    twb:liveLoad 2.5 ;
    twb:snowLoad 1.0 ;
    twb:windPressure 0.8 ;
    twb:consequenceClass "CC2" ;
    twb:sawnTimberGrade "C24" ;
    twb:ifcScope "complete" ;
    twb:hasJointStandard <https://example.org/twb/case-house/standard/wall-corner>, <https://example.org/twb/case-house/standard/wall-partition>, <https://example.org/twb/case-house/standard/eave>, <https://example.org/twb/case-house/standard/verge>, <https://example.org/twb/case-house/standard/wall-floor> ;
    twb:hasJointTemplate <https://example.org/twb/case-house/template/wall-corner%3AexteriorWall%7CexteriorWall> ;
    twb:hasOpeningStandard <https://example.org/twb/case-house/opening-standard/window>, <https://example.org/twb/case-house/opening-standard/door>, <https://example.org/twb/case-house/opening-standard/garage-door> ;
    twb:hasNodeRule <https://example.org/twb/case-house/node-rule/roof-1%7Cwall-east%20%2B%20roof-1%7Cwall-south~attic> ;
    twb:hasBlueprintPart <https://example.org/twb/case-house/storey/st1>, <https://example.org/twb/case-house/surface/floor>, <https://example.org/twb/case-house/surface/roof-1>, <https://example.org/twb/case-house/surface/roof-2>, <https://example.org/twb/case-house/surface/wall-south>, <https://example.org/twb/case-house/surface/wall-east>, <https://example.org/twb/case-house/surface/wall-north>, <https://example.org/twb/case-house/surface/wall-west>, <https://example.org/twb/case-house/surface/s1>, <https://example.org/twb/case-house/surface/s2>, <https://example.org/twb/case-house/surface/s3>, <https://example.org/twb/case-house/surface/s4>, <https://example.org/twb/case-house/zone/z-living>, <https://example.org/twb/case-house/zone/z-bath>, <https://example.org/twb/case-house/zone/z-bed1>, <https://example.org/twb/case-house/zone/z-bed2>, <https://example.org/twb/case-house/recipe/atticRoof>, <https://example.org/twb/case-house/recipe/atticWall>, <https://example.org/twb/case-house/recipe/ceiling>, <https://example.org/twb/case-house/recipe/exteriorWall>, <https://example.org/twb/case-house/recipe/floor>, <https://example.org/twb/case-house/recipe/interiorWall> .

<https://example.org/twb/case-house/expression>
    a twb:Expression ;
    skos:notation "overhang-barge" ;
    twb:facadeCladding "board-on-board" ;
    twb:roofCovering "tiles" ;
    twb:gutterKind "hung" ;
    rdfs:comment "openings frame-boards" .

<https://example.org/twb/case-house/building>
    a bot:Building ;
    rdfs:label "Case house"@en ;
    bot:hasStorey <https://example.org/twb/case-house/storey/st1> .

<https://example.org/twb/case-house/storey/st1>
    a bot:Storey ;
    rdfs:label "Ground floor"@en ;
    twb:elevation 0.0 ;
    twb:storeyHeight 4478.0 ;
    bot:hasSpace <https://example.org/twb/case-house/zone/z-living>, <https://example.org/twb/case-house/zone/z-bath>, <https://example.org/twb/case-house/zone/z-bed1>, <https://example.org/twb/case-house/zone/z-bed2>, <https://example.org/twb/case-house/zone/attic%3Afloor~ceiling> ;
    bot:hasElement <https://example.org/twb/case-house/surface/floor>, <https://example.org/twb/case-house/surface/roof-1>, <https://example.org/twb/case-house/surface/roof-2>, <https://example.org/twb/case-house/surface/wall-south>, <https://example.org/twb/case-house/surface/wall-south~attic>, <https://example.org/twb/case-house/surface/wall-east>, <https://example.org/twb/case-house/surface/wall-north>, <https://example.org/twb/case-house/surface/wall-north~attic>, <https://example.org/twb/case-house/surface/wall-west>, <https://example.org/twb/case-house/surface/s1>, <https://example.org/twb/case-house/surface/s2>, <https://example.org/twb/case-house/surface/s3>, <https://example.org/twb/case-house/surface/s4>, <https://example.org/twb/case-house/surface/floor~ceiling> .


