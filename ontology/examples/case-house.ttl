    twb:decides "envelope/wall-corner" ;
    twb:decidedValue "longer-through" ;
    twb:decisionTier twb:StandardTier ;
    twb:sourceNote "assumed: the case house of the paper" ;
    twb:isAssumed true .

<https://example.org/twb/case-house/decision/envelope%2Feave>
