<https://example.org/twb/case-house/zone/z-living>
    a twb:Room ;
    rdfs:label "Living and kitchen"@en ;
    twb:zoneKind <https://w3id.org/twb/catalogue/arch#zone-kind/living> ;
    twb:isHeated true ;
    twb:ceilingKind twb:FlatCeiling ;
    twb:seed [ a geo:Geometry ; geo:asWKT "<https://w3id.org/twb/crs/project-mm> POINT Z(2400.0 3000.0 0.0)"^^geo:wktLiteral ] ;
    geo:hasGeometry [ a geo:Geometry ; geo:asWKT "<https://w3id.org/twb/crs/project-mm> POLYGON Z((0.0 0.0 0.0, 4800.0 0.0 0.0, 4800.0 6000.0 0.0, 0.0 6000.0 0.0, 0.0 0.0 0.0))"^^geo:wktLiteral ] .

